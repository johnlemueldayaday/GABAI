# Ramsey chat defaults to a local offline OpenAI-compatible server.
# Ollama default:
AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.2:3b
LOCAL_AI_API_KEY=local-ai

# Optional: only needed if you switch AI_PROVIDER=gemini or use AI image scanning.
GEMINI_API_KEY=
